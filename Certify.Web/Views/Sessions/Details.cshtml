@model Certify.API.Models.ScheduledSession

@{
    ViewData["Title"] = Model.Course?.Title ?? "Session Details";
}

<div class="container mt-4">
    <a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i> Back to sessions</a>

    <div class="page-header">
        <div>
            <h2>@Model.Course?.Title</h2>
            <p class="subtitle">Session schedule and assignments.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary"><i class="bi bi-pencil me-1"></i> Edit</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
        </div>
    </div>

    <div class="card detail-card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Course</dt>
                <dd class="col-sm-9">@Model.Course?.Title <span class="text-muted">(@Model.Course?.Category)</span></dd>

                <dt class="col-sm-3">Instructor</dt>
                <dd class="col-sm-9">@Model.Instructor?.Name <span class="text-muted small">@Model.Instructor?.Email</span></dd>

                <dt class="col-sm-3">Room</dt>
                <dd class="col-sm-9">@Model.Room?.Name</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.StartDateTime)</dt>
                <dd class="col-sm-9">@Model.StartDateTime.ToString("MMM dd, yyyy HH:mm")</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.EndDateTime)</dt>
                <dd class="col-sm-9">@Model.EndDateTime.ToString("MMM dd, yyyy HH:mm")</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Capacity)</dt>
                <dd class="col-sm-9">@Model.Capacity</dd>
            </dl>
        </div>
    </div>
</div>
