@model IEnumerable<Certify.API.Models.Room>

@{
    ViewData["Title"] = "Rooms";
}

<div class="container mt-4">
    <div class="page-header">
        <div>
            <h2>Rooms</h2>
            <p class="subtitle">Training spaces available for scheduled sessions, with capacity and equipment.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> New Room</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No rooms have been added yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Name)</th>
                        <th class="text-center">@Html.DisplayNameFor(model => model.Capacity)</th>
                        <th>@Html.DisplayNameFor(model => model.Equipment)</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.Name</strong></td>
                            <td class="text-center">@item.Capacity</td>
                            <td class="text-muted small">@item.Equipment</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
