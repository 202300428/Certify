@model Certify.API.Models.Course

@{
    ViewData["Title"] = Model.Title ?? "Course Details";
}

<div class="container mt-4">
    <a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i> Back to courses</a>

    <div class="page-header">
        <div>
            <h2>@Model.Title</h2>
            <p class="subtitle">Course details and configuration.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary"><i class="bi bi-pencil me-1"></i> Edit</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
        </div>
    </div>

    <div class="card detail-card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Title)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Title)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Description)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Description)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Category)</dt>
                <dd class="col-sm-9"><span class="badge bg-secondary">@Model.Category</span></dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Fee)</dt>
                <dd class="col-sm-9">BHD @Model.Fee.ToString("F2")</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Capacity)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Capacity)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DurationHours)</dt>
                <dd class="col-sm-9">@Model.DurationHours hours</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.PrerequisiteCourse)</dt>
                <dd class="col-sm-9">
                    @if (Model.PrerequisiteCourse != null)
                    {
                        @Model.PrerequisiteCourse.Title
                    }
                    else
                    {
                        <span class="text-muted">— None —</span>
                    }
                </dd>
            </dl>
        </div>
    </div>
</div>
