@{
    ViewData["Title"] = "Welcome";
    Layout = "_Layout";
}

<div class="hero">
    <div class="container">
        <h1>Certification Courses from Certify</h1>
        <p>Professional training programs designed to take your career skills to the next level.</p>
    </div>
</div>

<div class="container">
    <div class="row justify-content-center text-center">
        <div class="col-md-8">
            <p class="lead text-muted mb-4">
                Browse our catalog of expert-led courses, track your progress, and earn industry-recognized certifications.
            </p>
            <div>
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary me-2">Sign In</a>
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary me-2">Get Started</a>
                <a asp-controller="Lookup" asp-action="Index" class="btn btn-outline-secondary">Verify Certificate</a>
            </div>
        </div>
    </div>
</div>