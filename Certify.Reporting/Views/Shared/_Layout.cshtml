@{
    var email = Context.Session.GetString(ReportingSessionKeys.Email);
    var isSignedIn = !string.IsNullOrWhiteSpace(email);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Certify Reports</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark report-navbar">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Reports" asp-action="Index">
                    <span class="brand-icon"><i class="bi bi-bar-chart-line-fill"></i></span>
                    Certify Reports
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#reportNav" aria-controls="reportNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="reportNav">
                    @if (isSignedIn)
                    {
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="Enrollments"><i class="bi bi-people"></i> Enrollments</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="InstructorWorkload"><i class="bi bi-person-badge"></i> Workload</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="CertificationCompletion"><i class="bi bi-patch-check"></i> Certifications</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="Revenue"><i class="bi bi-cash-coin"></i> Revenue</a></li>
                        </ul>
                        <div class="d-flex align-items-center gap-3">
                            <span class="nav-email"><i class="bi bi-person-circle"></i> @email</span>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-light"><i class="bi bi-box-arrow-right me-1"></i> Logout</button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right"></i> Login</a></li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="report-shell">
        @if (TempData["Error"] != null)
        {
            <div class="container pt-3">
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>&copy; 2026 Certify &middot; Reporting Application</span>
            <span class="small">Read-only API client</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
